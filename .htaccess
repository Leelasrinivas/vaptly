# ── Internal page redirects ──────────────────────────────
/index.html   /   301
/home         /   301
/home.html    /   301

# ── www → non-www (canonical domain enforcement) ─────────
https://www.vaptly.com/*   https://vaptly.com/:splat   301!

# ── HTTP → HTTPS fallback ────────────────────────────────
http://vaptly.com/*        https://vaptly.com/:splat   301!
http://www.vaptly.com/*    https://vaptly.com/:splat   301!
